{
  "name": "@cobalt/icons",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Material Symbols registry for the Cobalt Design System",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "import": "./dist/metadata.js"
    },
    "./all": {
      "types": "./dist/all.d.ts",
      "import": "./dist/all.js"
    },
    "./animated/*": {
      "types": "./dist/animated/*.d.ts",
      "import": "./dist/animated/*.js"
    },
    "./*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js"
    }
  },
  "sideEffects": [
    "./dist/icons/*.js",
    "./dist/animated/*.js",
    "./dist/all.js"
  ],
  "scripts": {
    "build": "node scripts/build-registry.js",
    "clean": "rm -rf dist",
    "test": "node --test",
    "refresh-categories": "node scripts/refresh-category-metadata.js"
  },
  "devDependencies": {
    "@material-symbols/svg-300": "^0.43.0"
  },
  "license": "MIT"
}
