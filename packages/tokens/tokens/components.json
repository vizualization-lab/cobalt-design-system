{
  "co": {
    "component": {
      "avatar": {
        "size": {
          "sm": {
            "$type": "dimension",
            "$value": "24px",
            "$description": "Compact avatar size for dense layouts, tables, and inline references."
          },
          "md": {
            "$type": "dimension",
            "$value": "32px",
            "$description": "Default avatar size for navigation, lists, and standard UI surfaces."
          },
          "lg": {
            "$type": "dimension",
            "$value": "38px",
            "$description": "Large avatar size for profile headers and prominent identity surfaces."
          }
        }
      },
      "card": {
        "padding": {
          "$type": "dimension",
          "$value": "{co.space.inset.lg}",
          "$description": "Internal padding for the card."
        },
        "gap": {
          "$type": "dimension",
          "$value": "{co.space.gap.sm}",
          "$description": "Gap between card sections."
        },
        "radius": {
          "$type": "dimension",
          "$value": "{co.control.radius.container}",
          "$description": "Corner radius for the card."
        },
        "background": {
          "$type": "color",
          "$value": "{co.color.surface.static.raised}",
          "$description": "Card background color."
        },
        "shadow": {
          "$type": "shadow",
          "$value": "{co.elevation.shadow.sm}",
          "$description": "Card elevation shadow."
        }
      },
      "nav": {
        "header": {
          "bar": {
            "height": {
              "$type": "dimension",
              "$value": "64px",
              "$description": "Minimum height for nav header bars."
            },
            "background": {
              "$type": "color",
              "$value": "{co.color.surface.static.default}",
              "$description": "Container background for nav header bars."
            },
            "border-color": {
              "$type": "color",
              "$value": "{co.color.border.subtle}",
              "$description": "Divider color for nav header bars."
            }
          }
        },
        "rail": {
          "bar": {
            "width": {
              "$type": "dimension",
              "$value": "116px",
              "$description": "Default width for compact vertical navigation rails."
            },
            "width-max": {
              "$type": "dimension",
              "$value": "140px",
              "$description": "Max width for compact vertical navigation rails."
            },
            "padding": {
              "x": {
                "$type": "dimension",
                "$value": "{co.space.2}",
                "$description": "Horizontal inset padding applied around nav rail items."
              },
              "y": {
                "$type": "dimension",
                "$value": "{co.space.3}",
                "$description": "Vertical inset padding applied around nav rail items."
              }
            },
            "gap": {
              "$type": "dimension",
              "$value": "{co.space.2}",
              "$description": "Vertical gap between nav rail items."
            }
          },
          "item": {
            "padding": {
              "x": {
                "$type": "dimension",
                "$value": "{co.space.3}",
                "$description": "Horizontal padding for each nav rail item."
              },
              "y": {
                "$type": "dimension",
                "$value": "{co.space.2}",
                "$description": "Vertical padding for each nav rail item."
              }
            },
            "gap": {
              "$type": "dimension",
              "$value": "{co.space.1}",
              "$description": "Space between the icon and label within a nav rail item."
            },
            "icon": {
              "size": {
                "$type": "dimension",
                "$value": "22px",
                "$description": "Default icon size for compact nav rail destinations."
              }
            }
          }
        },
        "drawer": {
          "width": {
            "$type": "dimension",
            "$value": "260px",
            "$description": "Default width for contextual navigation drawers."
          },
          "item": {
            "padding": {
              "x": {
                "$type": "dimension",
                "$value": "{co.space.3}",
                "$description": "Horizontal padding for each nav drawer item."
              },
              "y": {
                "$type": "dimension",
                "$value": "{co.space.2}",
                "$description": "Vertical padding for each nav drawer item."
              }
            },
            "margin": {
              "block": {
                "$type": "dimension",
                "$value": "{co.border.width.divider}",
                "$description": "Vertical margin around nav drawer item rows."
              }
            },
            "gap": {
              "$type": "dimension",
              "$value": "{co.space.gap.sm}",
              "$description": "Space between prefix content and label text within a nav drawer item."
            }
          },
          "group": {
            "gap": {
              "$type": "dimension",
              "$value": "{co.space.1}",
              "$description": "Vertical gap between a nav drawer group trigger and its content."
            },
            "margin": {
              "block-start": {
                "$type": "dimension",
                "$value": "{co.space.1}",
                "$description": "Top margin before a nav drawer group."
              }
            },
            "trigger": {
              "padding": {
                "x": {
                  "$type": "dimension",
                  "$value": "{co.space.3}",
                  "$description": "Horizontal padding for nav drawer group triggers."
                },
                "y": {
                  "$type": "dimension",
                  "$value": "{co.space.2}",
                  "$description": "Vertical padding for nav drawer group triggers."
                }
              },
              "gap": {
                "$type": "dimension",
                "$value": "{co.space.1}",
                "$description": "Space between the disclosure icon and label within a nav drawer group trigger."
              }
            },
            "content": {
              "gap": {
                "$type": "dimension",
                "$value": "{co.border.width.divider}",
                "$description": "Vertical gap between nested nav drawer group content rows."
              },
              "indent": {
                "$type": "dimension",
                "$value": "{co.space.2}",
                "$description": "Inline indentation applied to nested nav drawer group content."
              }
            }
          }
        }
      }
    }
  }
}
