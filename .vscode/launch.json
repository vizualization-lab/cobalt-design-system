{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Cobalt Extension (sample workspace)",
      "type": "extensionHost",
      "request": "launch",
      "preLaunchTask": "cobalt: build VS Code extension",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode",
        "${workspaceFolder}/packages/vscode/manual-test-workspace"
      ],
      "outFiles": ["${workspaceFolder}/packages/vscode/dist/**/*.js"]
    },
    {
      "name": "Launch Cobalt Extension (monorepo workspace)",
      "type": "extensionHost",
      "request": "launch",
      "preLaunchTask": "cobalt: build VS Code extension",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode",
        "${workspaceFolder}"
      ],
      "outFiles": ["${workspaceFolder}/packages/vscode/dist/**/*.js"]
    }
  ]
}
