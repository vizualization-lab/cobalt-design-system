# GitHub repository configuration (used by the docs site)
# COBALT_GITHUB_ORG=
# COBALT_GITHUB_REPO=cobalt-design-system
# COBALT_GITHUB_URL=https://github.com/your-org/cobalt-design-system
#
# VitePress base path for the docs site
# COBALT_DOCS_BASE=/cobalt-design-system/

# Private npm registry (used in docs code examples)
# COBALT_REGISTRY_URL=https://registry.your-org.com
#
# Certificate authority bundle path
# COBALT_CA_BUNDLE=
#
# Design system team contact email
# COBALT_CONTACT_EMAIL=DESIGN_SYSTEM
#
# Banner text
# COBALT_BANNER=ALPHA
#
# Matomo analytics (optional; docs analytics stay disabled unless these are configured)
# COBALT_MATOMO_SITE_ID=1
# COBALT_MATOMO_BASE_URL=https://matomo.your-org.com/
#
# Optional Matomo URL overrides for proxied or custom deployments
# COBALT_MATOMO_SCRIPT_URL=https://matomo.your-org.com/matomo.js
# COBALT_MATOMO_TRACKER_URL=https://matomo.your-org.com/matomo.php
